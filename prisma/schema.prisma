// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(cuid())
  name      String
  pin       String   @unique
  isAdmin   Boolean  @default(false)
  createdAt DateTime @default(now())
  
  posts        Post[]
  memes        Meme[]
  memeVotes    MemeVote[]
  gamePlayers  GamePlayer[]
  gameStats    GameStats[]
  questions    Question[]
  questionUpvotes QuestionUpvote[]
}

model Post {
  id        String   @id @default(cuid())
  content   String
  userId    String
  parentId  String?
  createdAt DateTime @default(now())
  
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  parent    Post?    @relation("PostReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies   Post[]   @relation("PostReplies")
  
  @@index([parentId])
  @@index([userId])
}

model Meme {
  id         String   @id @default(cuid())
  imageUrl   String
  templateId String?
  caption    String   // JSON string of text boxes
  userId     String
  upvotes    Int      @default(0)
  downvotes  Int      @default(0)
  createdAt  DateTime @default(now())
  
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  votes      MemeVote[]
  
  @@index([userId])
}

model MemeVote {
  id       String @id @default(cuid())
  memeId   String
  userId   String
  voteType String // "up" or "down"
  
  meme     Meme   @relation(fields: [memeId], references: [id], onDelete: Cascade)
  user     User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  @@unique([memeId, userId])
  @@index([memeId])
  @@index([userId])
}

model TimetableEntry {
  id        String   @id @default(cuid())
  startTime String   // Time in format "HH:mm" (e.g., "8:00", "14:30")
  endTime   String?  // Optional end time for duration display
  day       String   // "friday", "saturday", "sunday"
  content   String   // Activity description
  createdAt DateTime @default(now())
  
  @@index([day, startTime])
}

model Game {
  id          String   @id @default(cuid())
  gameType    String   // "tictactoe", "trivia", "word_guess", "racing", etc.
  gameState   String   // JSON string of game-specific state (board, cards, questions, etc.)
  currentTurn String?  // userId of player whose turn it is (null for real-time games)
  moveCount   Int      @default(0) // Track number of moves/turns
  status      String   @default("active") // "active", "completed", "abandoned"
  startedAt   DateTime @default(now())
  completedAt DateTime?
  
  players     GamePlayer[]
  
  @@index([gameType])
  @@index([status])
}

model GamePlayer {
  id         String   @id @default(cuid())
  gameId     String
  userId     String
  playerRole String?  // Game-specific role: "X", "O", "dealer", "team1", etc.
  score      Int      @default(0) // For games with scoring
  placement  Int?     // Final placement: 1 = winner, 2 = second, etc.
  joinedAt   DateTime @default(now())
  
  game       Game     @relation(fields: [gameId], references: [id], onDelete: Cascade)
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  @@unique([gameId, userId])
  @@index([gameId])
  @@index([userId])
}

model GameStats {
  id       String @id @default(cuid())
  userId   String
  gameType String // "tictactoe", "trivia", etc.
  wins     Int    @default(0)
  losses   Int    @default(0)
  draws    Int    @default(0)
  totalGames Int  @default(0)
  
  user     User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  @@unique([userId, gameType])
  @@index([userId])
  @@index([gameType])
}

model Question {
  id        String   @id @default(cuid())
  content   String
  userId    String
  resolved  Boolean  @default(false)
  createdAt DateTime @default(now())
  
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  upvotes   QuestionUpvote[]
  
  @@index([userId])
}

model QuestionUpvote {
  id         String   @id @default(cuid())
  questionId String
  userId     String

  question   Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([questionId, userId])
  @@index([questionId])
  @@index([userId])
}
